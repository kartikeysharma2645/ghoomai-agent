# GhoomAI Agent environment variables
# Copy this file to .env and fill in real values for local development.
# Never commit .env; it is excluded by .gitignore.

# GhoomAI API configuration
GHOOMAI_API_BASE_URL=https://ghoomai.netlify.app
GHOOMAI_API_TIMEOUT=30.0

# Fetch.ai Agent configuration (needed to run the agent runtime)
AGENT_SEED_PHRASE=your-agent-seed-phrase-here
AGENT_PORT=8001
AGENT_NETWORK=mainnet

# Fetch.ai Agentverse configuration (needed for future agent registration)
AGENTVERSE_API_KEY=your-agentverse-api-key-here
