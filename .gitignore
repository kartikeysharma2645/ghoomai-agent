# GhoomAI Agent - Python development environment

# Virtual environment
.venv/

# Environment files (exclude all .env and .env.* except the example template)
.env
.env.*
!.env.example

# Python generated files
__pycache__/
*.py[cod]
*$py.class
*.pyc

# C extensions
*.so
*.pyd

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.installed.cfg

# Testing caches
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
